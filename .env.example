SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_KEY=your_service_role_or_anon_key

# Opt-in signed-in smoke test (scripts/smoke_signed_in.py).
# Leave TOOL_ROOM_SMOKE unset to skip. The script never checks a tool out.
# TOOL_ROOM_SMOKE=1
# TOOL_ROOM_SMOKE_ROLE=technician
# TOOL_ROOM_SMOKE_PASSWORD=the-shared-tech-password
# TOOL_ROOM_SMOKE_USERNAME=admin
# Daily backup uses SUPABASE_SERVICE_ROLE_KEY instead of SUPABASE_KEY.
# Put that key in GitHub Actions secrets, not in this file.
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
